# ⚠️ このファイルはテンプレートです。実運用ではコピーして `secrets.toml` を作り、
#    Streamlit Community Cloud にデプロイする場合は「Advanced settings → Secrets」に
#    以下の内容を貼り付けてください（GitHub にはコミット禁止）。

# ──────────────────────────────────
# パターンA: マルチブランド（推奨・1アプリで複数ブランド切替）
# ──────────────────────────────────
# [brands.<キー>] 形式で複数ブランドを定義するだけで、
# サイドバー上部にブランド切替 selectbox が自動表示されます。
# ブランド切替時はそのブランドのデータだけを読み込み（10分キャッシュ済）。

[brands.haju]
display_name = "hajuCS"
theme        = "gold"          # gold / green / blue
# special_course = "晩酌応援コース"  # 省略時はデータから自動検出

  [brands.haju.sheets]
  LU = "https://docs.google.com/spreadsheets/d/e/xxxxxxxxxxxx"
  N2 = "https://docs.google.com/spreadsheets/d/e/yyyyyyyyyyyy"

[brands.coheart]
display_name  = "Co-HeartCS"
theme         = "green"
special_course = "すまいる応援コース"

  [brands.coheart.sheets]
  LU = "https://docs.google.com/spreadsheets/d/e/zzzzzzzzzzzz"
  N2 = "https://docs.google.com/spreadsheets/d/e/wwwwwwwwwwww"

[brands.toaruhi]
display_name  = "TOARUHI"
theme         = "blue"
special_course = "プレミアムコース"

  [brands.toaruhi.sheets]
  LU = "https://docs.google.com/spreadsheets/d/e/aaaaaaaaaaaa"
  N2 = "https://docs.google.com/spreadsheets/d/e/bbbbbbbbbbbb"

# 4 ブランド目以降も同じ形で追加してください。


# ──────────────────────────────────
# パターンB: 単一ブランド（従来互換・1アプリ 1ブランド）
# ──────────────────────────────────
